# JSON Ledger API of the participant node to talk to
LEDGER_URL=http://localhost:6864
# Ledger API user the app submits as (local sandbox has no auth)
LEDGER_USER_ID=participant_admin
# How often each firm's automation checks for new acceptances
AUTOMATION_POLL_MS=500
# Demo chain: parties, links, amounts and payment terms (relative to repo root)
SCENARIO_FILE=data/demo-scenario.json
# Where the setup script records the party ids of the latest run (git-ignored)
RUN_FILE=.local/run.json
