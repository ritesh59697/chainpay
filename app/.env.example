# "network": one participant node per firm (npm run network)
# "sandbox": every party on one node (dpm sandbox)
LEDGER_TOPOLOGY=network
# Network mode: nodes, ports and which party each node hosts (relative to repo root)
NETWORK_FILE=data/network.json
# Network mode: host the nodes run on
NETWORK_HOST=localhost
# Sandbox mode: JSON Ledger API of the sandbox
LEDGER_URL=http://localhost:6864
# Ledger API user the app submits as (local sandbox has no auth)
LEDGER_USER_ID=participant_admin
# How often each firm's automation checks for new acceptances
AUTOMATION_POLL_MS=500
# How long to wait for a node to see what another node just committed
SETTLE_TIMEOUT_MS=20000
# Demo chain: parties, links, amounts and payment terms (relative to repo root)
SCENARIO_FILE=data/demo-scenario.json
# Where the setup script records the party ids of the latest run (git-ignored)
RUN_FILE=.local/run.json
