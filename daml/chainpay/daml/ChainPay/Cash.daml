-- | A demo payment token. It stands in for a bank transfer so the whole
-- flow can run on a test network. Real settlement would go over bank rails,
-- with ChainPay recording the obligation and the proof of payment.
module ChainPay.Cash where

template DemoCash
  with
    issuer : Party
    owner : Party
    amount : Decimal
    currency : Text
  where
    signatory issuer
    observer owner
    ensure amount > 0.0 && currency /= ""

    -- | Hand the whole holding to someone else. The issuer's authority comes
    -- from this contract, so the new owner does not need to sign.
    choice Transfer : ContractId DemoCash
      with
        newOwner : Party
      controller owner
      do create this with owner = newOwner

    -- | Break off an exact amount. Pay the exact holding afterwards, so the
    -- payee never sees what is left in your balance.
    choice Split : (ContractId DemoCash, ContractId DemoCash)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "split amount must be positive and smaller than the holding"
          (splitAmount > 0.0 && splitAmount < amount)
        part <- create this with amount = splitAmount
        rest <- create this with amount = amount - splitAmount
        pure (part, rest)
